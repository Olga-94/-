    function restartCard() {
      if(!confirm('Почати картку знову? Відповіді, результати, таймер, записи та самооцінювання буде скинуто.'))return;
      clearInterval(timerHandle);state.answers={1:'',2:'',3:'',4:''};state.solved={1:false,2:false,3:false,4:false};state.attempts={1:0,2:0,3:0,4:0};state.feedback={1:'',2:'',3:'',4:''};state.feedbackType={1:'',2:'',3:'',4:''};state.solutionsShown={1:false,2:false,3:false,4:false};state.self='';state.timer={remaining:TOTAL_SECONDS,running:false,ended:false,lastTick:null};state.drawings={1:[],2:[],3:[],4:[]};
      Object.values(canvasManagers).forEach(m=>{m.actions=[];m.redoStack=[];m.redraw();m.updateHistoryButtons();});syncInputsFromState();$('#resultBox').textContent='Перевірте відповіді, щоб побачити результат.';saveState();toast('Картку розпочато знову.');
    }
    function restartWithoutPrompt(){clearInterval(timerHandle);Object.assign(state,{studentName:'',cardNumber:'',workDate:todayISO(),answers:{1:'',2:'',3:'',4:''},solved:{1:false,2:false,3:false,4:false},attempts:{1:0,2:0,3:0,4:0},feedback:{1:'',2:'',3:'',4:''},feedbackType:{1:'',2:'',3:'',4:''},solutionsShown:{1:false,2:false,3:false,4:false},self:'',timer:{remaining:TOTAL_SECONDS,running:false,ended:false,lastTick:null},drawings:{1:[],2:[],3:[],4:[]}});Object.values(canvasManagers).forEach(m=>{m.actions=[];m.redoStack=[];m.redraw();m.updateHistoryButtons();});syncInputsFromState();$('#resultBox').textContent='Перевірте відповіді, щоб побачити результат.';}

    function answerDisplay(n){if(n===2){const map={А:'А — −13',Б:'Б — −9',В:'В — −5',Г:'Г — 4',Д:'Д — 13'};return map[state.answers[2]]||'Не обрано';}return String(state.answers[n]||'Не введено');}
    function statusDisplay(n){return !hasAnswer(n)?'Відповідь не надано':state.solved[n]?'Правильно':'Неправильно або ще не перевірено';}
    function makePdfPage(inner){const page=document.createElement('section');page.className='pdf-page';page.innerHTML=`<div class="pdf-panel">${inner}</div>`;return page;}
    function pdfHeader(){
      return `<div class="pdf-sheet-head"><div><div class="eyebrow">Підготовка до НМТ • Математика</div><h1>Математична п’ятихвилинка</h1><p><strong>Тема:</strong> Натуральні та цілі числа. Порядок дій</p><p><strong>Учень/учениця:</strong> ${escapeHTML(state.studentName||'Не вказано')} · <strong>Картка №:</strong> ${escapeHTML(state.cardNumber||'___')} · <strong>Дата:</strong> ${escapeHTML(formatDate(state.workDate))}</p></div><div class="pdf-page-number">Сторінка 1 з 1</div></div>`;
    }
    function pdfTask(n){
      return `<section class="pdf-task"><h2>${TASKS[n].title}</h2><p class="pdf-question">${TASKS[n].text}</p><div class="pdf-answer">Відповідь: ${escapeHTML(answerDisplay(n))} · ${statusDisplay(n)}</div><img class="pdf-canvas-image" src="${canvasManagers[n].compositeDataURL(2)}" alt="Записи до завдання ${n}"></section>`;
    }
    function buildPdfPages(){
      const stage=$('#pdfStage');stage.innerHTML='';
      stage.append(makePdfPage(`${pdfHeader()}<div class="pdf-tasks">${pdfTask(1)}${pdfTask(2)}${pdfTask(3)}${pdfTask(4)}</div><div class="pdf-summary"><span>${resultText()} · Виконано: ${score()} із 4</span><span>Самооцінювання: ${escapeHTML(state.self||'Не обрано')} · Моя ціль — 200!</span></div>`));
      return $$('.pdf-page',stage);
    }
    function escapeHTML(value){const d=document.createElement('div');d.textContent=String(value);return d.innerHTML;}
    function formatDate(value){if(!value)return 'Не вказано';const [y,m,d]=value.split('-');return y&&m&&d?`${d}.${m}.${y}`:value;}
    async function downloadPdf(){
      if(!window.html2canvas||!window.jspdf){toast('Не вдалося завантажити модуль PDF. Перевірте інтернет і спробуйте ще раз.');return;}
      $('#busyMask').classList.remove('hidden');$('#downloadPdf').disabled=true;
      try{
        const pages=buildPdfPages();
        await Promise.all($$('img',$('#pdfStage')).map(img => img.decode ? img.decode().catch(()=>{}) : Promise.resolve()));
        await new Promise(r=>requestAnimationFrame(()=>requestAnimationFrame(r)));
        const pdfPage=pages[0];
        if(!pdfPage || pages.length !== 1) throw new Error('PDF-макет повинен містити рівно одну сторінку');
        const canvas=await window.html2canvas(pdfPage,{scale:1.7,useCORS:true,backgroundColor:'#ffffff',logging:false,width:794,height:1123,windowWidth:794,windowHeight:1123});
        const {jsPDF}=window.jspdf;
        const pdf=new jsPDF({orientation:'portrait',unit:'mm',format:[210,297],compress:true,putOnlyUsedFonts:true});
        const pageWidth=pdf.internal.pageSize.getWidth();
        const pageHeight=pdf.internal.pageSize.getHeight();
        const scale=Math.min(pageWidth/canvas.width,pageHeight/canvas.height);
        const imageWidth=canvas.width*scale;
        const imageHeight=canvas.height*scale;
        const offsetX=(pageWidth-imageWidth)/2;
        const offsetY=(pageHeight-imageHeight)/2;
        const image=canvas.toDataURL('image/jpeg',.91);
        pdf.addImage(image,'JPEG',offsetX,offsetY,imageWidth,imageHeight,undefined,'FAST');
        while(pdf.getNumberOfPages()>1) pdf.deletePage(pdf.getNumberOfPages());
        if(pdf.getNumberOfPages()!==1) throw new Error('Не вдалося сформувати односторінковий PDF');
        const filename=`П’ятихвилинка_Натуральні_та_цілі_числа_Порядок_дій_${safeFilePart(state.studentName)}_${safeFilePart(state.workDate||todayISO())}.pdf`;
        pdf.save(filename);toast('PDF успішно завантажено');
      }catch(error){console.error(error);toast('Не вдалося створити PDF. Спробуйте ще раз.');}
      finally{$('#pdfStage').innerHTML='';$('#busyMask').classList.add('hidden');$('#downloadPdf').disabled=false;}
    }

    function bindGlobal(){
      $('#timerStart').addEventListener('click',startTimer);$('#timerPause').addEventListener('click',pauseTimer);$('#timerReset').addEventListener('click',()=>{if(confirm('Почати відлік часу знову?'))resetTimer();});
      $('#checkAll').addEventListener('click',()=>{TASK_IDS.forEach(n=>checkTask(n,true));updateProgress(true);$('#resultBox').scrollIntoView({behavior:'smooth',block:'center'});});
      $('#clearAnswers').addEventListener('click',clearAnswers);$('#restartCard').addEventListener('click',restartCard);$('#printWork').addEventListener('click',()=>window.print());$('#downloadPdf').addEventListener('click',downloadPdf);
    }
    function init(){clearLegacySavedState();restartWithoutPrompt();syncInputsFromState();bindStateInputs();initCanvases();bindGlobal();window.addEventListener('pageshow',()=>{clearLegacySavedState();restartWithoutPrompt();});}
    if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
  })();
  </script>
</body>
