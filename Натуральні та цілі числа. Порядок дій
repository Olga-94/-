      $('#solution'+n).classList.toggle('hidden', !state.solutionsShown[n]);
    }
    function score() { return TASK_IDS.filter(n => state.solved[n]).length; }
    function resultText(value=score()) {
      return value === 4 ? '4/4 — чудова робота!' : value === 3 ? '3/4 — дуже добре!' : value === 2 ? '2/4 — хороший результат!' : value === 1 ? '1/4 — варто ще трохи потренуватися' : '0/4 — повтори правила та спробуй ще раз';
    }
    function updateProgress(showResult=false) {
      const value = score();
