    }

    function renderTimer() {
      const mins = Math.floor(state.timer.remaining/60).toString().padStart(2,'0');
      const secs = (state.timer.remaining%60).toString().padStart(2,'0');
      const timer = $('#timer'); timer.textContent = `${mins}:${secs}`;
      timer.classList.toggle('warning', state.timer.remaining <= 30 && state.timer.remaining > 0);
      $('#timerAlert').textContent = state.timer.ended ? 'Час завершився!' : state.timer.remaining <= 30 && state.timer.remaining > 0 ? 'Залишилося менше 30 секунд!' : '';
      $('#timerStart').disabled = state.timer.running || state.timer.remaining === 0;
      $('#timerPause').disabled = !state.timer.running;
    }
    function startTimer() {
      if (state.timer.remaining <= 0) return;
      state.timer.running = true; state.timer.lastTick = Date.now(); renderTimer();
      clearInterval(timerHandle);
      timerHandle = setInterval(() => {
        const elapsed = Math.floor((Date.now()-state.timer.lastTick)/1000);
        if (elapsed < 1) return;
        state.timer.remaining = Math.max(0,state.timer.remaining-elapsed); state.timer.lastTick = Date.now();
        if (state.timer.remaining === 0) { state.timer.running=false; state.timer.ended=true; clearInterval(timerHandle); toast('Час завершився!'); }
        renderTimer(); saveState();
      },250);
      saveState();
    }
    function pauseTimer() { state.timer.running=false; state.timer.lastTick=null; clearInterval(timerHandle); renderTimer(); saveState(); }
    function resetTimer() { clearInterval(timerHandle); state.timer={remaining:TOTAL_SECONDS,running:false,ended:false,lastTick:null}; renderTimer(); saveState(); }

    class CanvasManager {
      constructor(workspace, index) {
        this.workspace=workspace; this.index=index; this.canvas=$('canvas',workspace); this.shell=$('.canvas-shell',workspace); this.ctx=this.canvas.getContext('2d');
        this.actions=Array.isArray(state.drawings[index]) ? state.drawings[index] : []; this.redoStack=[];
        this.tool='pen'; this.color='#111111'; this.width=4; this.drawing=false; this.current=null;
        this.buildToolbar(); this.bind(); this.resize();
        this.resizeObserver = new ResizeObserver(() => this.resize()); this.resizeObserver.observe(this.shell);
      }
      buildToolbar() {
        const toolbar=$('.toolbar',this.workspace);
        toolbar.innerHTML=`
          <div class="tool-group" aria-label="Інструменти">
            <button type="button" class="tool active" data-tool="pen" aria-label="Ручка" title="Ручка">✎ Ручка</button>
            <button type="button" class="tool" data-tool="eraser" aria-label="Гумка" title="Гумка">⌫ Гумка</button>
            <button type="button" class="tool" data-tool="segment" aria-label="Відрізок" title="Відрізок">╱ Відрізок</button>
          </div>
          <div class="tool-group" aria-label="Товщина лінії">
            ${[2,4,6,10].map(w=>`<button type="button" class="width-tool ${w===4?'active':''}" data-width="${w}" aria-label="Товщина ${w} пікселі">${w}px</button>`).join('')}
          </div>
          <div class="tool-group" aria-label="Колір лінії">
            ${[['#111111','чорний'],['#1659b7','синій'],['#c62d42','червоний'],['#2d8b45','зелений'],['#7a3eb1','фіолетовий']].map(([c,n],i)=>`<button type="button" class="swatch ${i===0?'active':''}" style="--swatch:${c}" data-color="${c}" aria-label="Колір: ${n}" title="${n}"></button>`).join('')}
            <input class="color-picker" type="color" value="#A93C71" aria-label="Вибрати довільний колір" title="Довільний колір">
          </div>
          <div class="tool-group" aria-label="Історія та очищення">
            <button type="button" class="tool undo" aria-label="Скасувати останню дію" title="Назад">↶ Назад</button>
            <button type="button" class="tool redo" aria-label="Повернути скасовану дію" title="Повернути">↷ Повернути</button>
            <button type="button" class="tool clear" aria-label="Очистити поле" title="Очистити поле">Очистити поле</button>
          </div>`;
        $$('[data-tool]',toolbar).forEach(btn=>btn.addEventListener('click',()=>{ this.tool=btn.dataset.tool; $$('[data-tool]',toolbar).forEach(b=>b.classList.toggle('active',b===btn)); }));
        $$('[data-width]',toolbar).forEach(btn=>btn.addEventListener('click',()=>{ this.width=Number(btn.dataset.width); $$('[data-width]',toolbar).forEach(b=>b.classList.toggle('active',b===btn)); }));
        $$('[data-color]',toolbar).forEach(btn=>btn.addEventListener('click',()=>{ this.color=btn.dataset.color; $$('[data-color]',toolbar).forEach(b=>b.classList.toggle('active',b===btn)); }));
        $('.color-picker',toolbar).addEventListener('input',e=>{ this.color=e.target.value; $$('[data-color]',toolbar).forEach(b=>b.classList.remove('active')); e.target.classList.add('active'); });
        $('.undo',toolbar).addEventListener('click',()=>this.undo()); $('.redo',toolbar).addEventListener('click',()=>this.redo()); $('.clear',toolbar).addEventListener('click',()=>this.clear());
        this.updateHistoryButtons();
      }
      bind() {
        this.canvas.addEventListener('pointerdown',e=>this.start(e));
        this.canvas.addEventListener('pointermove',e=>this.move(e));
        this.canvas.addEventListener('pointerup',e=>this.end(e));
        this.canvas.addEventListener('pointercancel',e=>this.end(e));
        this.canvas.addEventListener('contextmenu',e=>e.preventDefault());
      }
      point(e) { const r=this.canvas.getBoundingClientRect(); return {x:Math.max(0,Math.min(r.width,e.clientX-r.left)),y:Math.max(0,Math.min(r.height,e.clientY-r.top))}; }
      start(e) { if (e.button !== undefined && e.button !== 0) return; e.preventDefault(); this.canvas.setPointerCapture(e.pointerId); this.drawing=true; const p=this.point(e); this.current={type:this.tool,color:this.color,width:this.width,points:[p]}; this.redoStack=[]; this.redraw(this.current); }
      move(e) { if(!this.drawing) return; e.preventDefault(); const p=this.point(e); if(this.tool==='segment') this.current.points=[this.current.points[0],p]; else this.current.points.push(p); this.redraw(this.current); }
      end(e) { if(!this.drawing) return; e.preventDefault(); this.drawing=false; if(this.current && this.current.points.length){ this.actions.push(this.current); state.drawings[this.index]=this.actions; } this.current=null; this.redraw(); this.updateHistoryButtons(); scheduleSave(); }
      resize() { const rect=this.shell.getBoundingClientRect(); const dpr=Math.max(1,window.devicePixelRatio||1); const w=Math.max(1,Math.round(rect.width)); const h=Math.max(150,Math.round(rect.height)); if(this.canvas.width!==Math.round(w*dpr)||this.canvas.height!==Math.round(h*dpr)){ this.canvas.width=Math.round(w*dpr); this.canvas.height=Math.round(h*dpr); this.canvas.style.width=w+'px'; this.canvas.style.height=h+'px'; this.logicalWidth=w; this.logicalHeight=h; this.dpr=dpr; this.redraw(); } }
      drawAction(action) { const ctx=this.ctx,dpr=this.dpr||1,pts=action.points||[]; if(!pts.length)return; ctx.save(); ctx.scale(dpr,dpr); ctx.lineCap='round'; ctx.lineJoin='round'; ctx.lineWidth=(action.width||4)*(action.type==='eraser'?2.2:1); ctx.strokeStyle=action.color||'#111'; ctx.globalCompositeOperation=action.type==='eraser'?'destination-out':'source-over'; ctx.beginPath(); ctx.moveTo(pts[0].x,pts[0].y); if(action.type==='segment'&&pts[1]) ctx.lineTo(pts[1].x,pts[1].y); else if(pts.length===1){ctx.lineTo(pts[0].x+.01,pts[0].y+.01);} else { for(let i=1;i<pts.length-1;i++){const mid={x:(pts[i].x+pts[i+1].x)/2,y:(pts[i].y+pts[i+1].y)/2};ctx.quadraticCurveTo(pts[i].x,pts[i].y,mid.x,mid.y);} ctx.lineTo(pts[pts.length-1].x,pts[pts.length-1].y); } ctx.stroke(); ctx.restore(); }
      redraw(preview=null) {
        const ctx=this.ctx;
        ctx.setTransform(1,0,0,1,0,0);
        ctx.globalCompositeOperation='source-over';
        ctx.clearRect(0,0,this.canvas.width,this.canvas.height);
        this.actions.forEach(a=>this.drawAction(a));
        if(preview)this.drawAction(preview);
        ctx.globalCompositeOperation='source-over';
      }
      undo(){if(!this.actions.length)return;this.redoStack.push(this.actions.pop());state.drawings[this.index]=this.actions;this.redraw();this.updateHistoryButtons();scheduleSave();}
      redo(){if(!this.redoStack.length)return;this.actions.push(this.redoStack.pop());state.drawings[this.index]=this.actions;this.redraw();this.updateHistoryButtons();scheduleSave();}
      clear(){if(!this.actions.length)return;if(confirm('Очистити всі записи в цій робочій області?')){this.actions=[];this.redoStack=[];state.drawings[this.index]=[];this.redraw();this.updateHistoryButtons();scheduleSave();}}
      updateHistoryButtons(){const t=$('.toolbar',this.workspace);$('.undo',t).disabled=!this.actions.length;$('.redo',t).disabled=!this.redoStack.length;}
      compositeDataURL(scale=2) { const w=Math.round(this.logicalWidth||this.shell.clientWidth),h=Math.round(this.logicalHeight||this.shell.clientHeight); const out=document.createElement('canvas');out.width=w*scale;out.height=h*scale;const c=out.getContext('2d');c.scale(scale,scale);c.fillStyle='#fff';c.fillRect(0,0,w,h);c.strokeStyle='rgba(112,190,226,.55)';c.lineWidth=1;for(let x=.5;x<=w;x+=20){c.beginPath();c.moveTo(x,0);c.lineTo(x,h);c.stroke();}for(let y=.5;y<=h;y+=20){c.beginPath();c.moveTo(0,y);c.lineTo(w,y);c.stroke();}c.drawImage(this.canvas,0,0,this.canvas.width,this.canvas.height,0,0,w,h);return out.toDataURL('image/png');}
    }

    function initCanvases() { $$('.workspace').forEach(w=>{ const n=Number(w.dataset.canvas); canvasManagers[n]=new CanvasManager(w,n); }); }
    function clearAnswers() {
      if(!confirm('Очистити всі введені та вибрані відповіді?'))return;
      state.answers={1:'',2:'',3:'',4:''};state.solved={1:false,2:false,3:false,4:false};state.attempts={1:0,2:0,3:0,4:0};state.feedback={1:'',2:'',3:'',4:''};state.feedbackType={1:'',2:'',3:'',4:''};state.solutionsShown={1:false,2:false,3:false,4:false};
      syncInputsFromState();$('#resultBox').textContent='Перевірте відповіді, щоб побачити результат.';saveState();
