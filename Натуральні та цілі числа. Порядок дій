    }

    function hasAnswer(n) { return n === 2 ? Boolean(state.answers[2]) : cleanNumber(state.answers[n]) !== null; }
    function isCorrect(n) {
      if (n === 2) return state.answers[2] === ANSWERS[2];
      const value = cleanNumber(state.answers[n]);
      return value !== null && Math.abs(value - ANSWERS[n]) <= .001;
    }
    function checkTask(n, countAttempt=true) {
      if (!hasAnswer(n)) {
        state.feedback[n] = 'Спочатку введи або обери відповідь.';
        state.feedbackType[n] = 'info'; renderTaskState(n); scheduleSave(); return false;
      }
      const correct = isCorrect(n);
      if (correct) {
        state.solved[n] = true;
        state.feedback[n] = '✓ Правильно! Молодець!';
        state.feedbackType[n] = 'success';
      } else {
        if (countAttempt) state.attempts[n] = Math.min(3, Number(state.attempts[n] || 0) + 1);
        state.feedback[n] = '✕ Перевір обчислення та спробуй ще раз.';
        state.feedbackType[n] = 'error';
      }
      renderTaskState(n); updateProgress(); scheduleSave(); return correct;
    }
    function renderTaskState(n) {
      const feedback = $('#feedback'+n);
