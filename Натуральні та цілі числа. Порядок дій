    }

    function bindStateInputs() {
      ['studentName','cardNumber','workDate'].forEach(id => $('#'+id).addEventListener('input', e => { state[id] = e.target.value; scheduleSave(); }));
      [1,3,4].forEach(n => $('#answer'+n).addEventListener('input', e => { state.answers[n] = e.target.value; clearVisualValidation(n); scheduleSave(); }));
      $$('input[name="answer2"]').forEach(r => r.addEventListener('change', e => { state.answers[2] = e.target.value; clearVisualValidation(2); scheduleSave(); }));
